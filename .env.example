# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
AI_KEYS_ENCRYPTION_KEY=

# Temporary fallback used by the Phase 1 AI runtime until Phase 3 routing is enabled.
GEMINI_API_KEY=

# Optional production error monitoring. The DSN may be public; auth token must remain server/build only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
