# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
AI_KEYS_ENCRYPTION_KEY=

# Optional dedicated HMAC salt for rate-limit identifiers. If omitted, the
# server falls back to another existing server-only secret; raw IPs are never stored.
RATE_LIMIT_HASH_SALT=

# Optional additional browser origins allowed to call public AI APIs.
# Comma-separated, for example: https://abhiai.vercel.app,https://www.example.com
PUBLIC_API_ALLOWED_ORIGINS=

# Cloudflare Turnstile bot protection. Protection activates only when BOTH
# the public site key and server-only secret are configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated extra hostnames accepted from Siteverify.
TURNSTILE_ALLOWED_HOSTNAMES=

# Temporary fallback used by the AI runtime only when Supabase provider config is unavailable.
GEMINI_API_KEY=

# Phase 1 safety flags. Unfinished public surfaces stay hidden unless explicitly enabled.
NEXT_PUBLIC_ENABLE_PUBLIC_IMAGE_STUDIO=false
NEXT_PUBLIC_ENABLE_LIVE_VOICE=false

# Optional production error monitoring. The DSN may be public; auth token must remain server/build only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
